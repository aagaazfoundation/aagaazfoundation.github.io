---
layout: null
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
{%- comment -%} A list of every page, for search engines. It updates itself: nothing to edit here. {%- endcomment %}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in site.pages %}
{%- unless p.url contains "/" %}{% continue %}{% endunless %}
{%- if p.sitemap == false or p.url == "/404.html" %}{% continue %}{% endif %}
{%- assign last = p.url | slice: -1, 1 %}
{%- unless last == "/" or p.url contains ".html" %}{% continue %}{% endunless %}
{%- if p.ref == "find-help" and site.directory.live != true %}{% continue %}{% endif %}
  <url><loc>{{ p.url | absolute_url }}</loc>{% if p.last_updated %}<lastmod>{{ p.last_updated | date: "%Y-%m-%d" }}</lastmod>{% endif %}</url>
{%- endfor %}
{%- for c in site.collections %}{% if c.output %}{% for d in c.docs %}{% if d.sitemap != false %}
  <url><loc>{{ d.url | absolute_url }}</loc></url>
{%- endif %}{% endfor %}{% endif %}{% endfor %}
</urlset>
